# Copy to .env and adjust. .env is gitignored; never commit real credentials.
# Serving settings (read by milk10k_serving.settings; empty = default shown).

# Model package folder (written by notebooks/08_export_for_deployment.ipynb or downloaded from the GitHub Release)
MODEL_DIR=artifacts/model_package/final-P1a-kg-onnx
# Check every package file against manifest.json at startup (true/false)
MODEL_VERIFY_SHA256=true
# ONNX Runtime threads per session
ORT_INTRA_OP_THREADS=4
# Largest accepted image upload, in MB
MAX_UPLOAD_MB=10
# /predict requests running inference at the same time (sized from docs/serving_measurements.md)
MAX_CONCURRENT_PREDICTIONS=2
# Further /predict requests that wait for a free slot; beyond this they get 503 with Retry-After (0 = no queue)
MAX_QUEUED_PREDICTIONS=8
# Largest decoded image in pixels (width x height); OpenCV's own variable, read when cv2 is first imported
OPENCV_IO_MAX_IMAGE_PIXELS=25000000
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
# Tracing (OTLP to Jaeger); leave the endpoint empty to disable tracing
OTEL_SERVICE_NAME=milk10k-api
OTEL_EXPORTER_OTLP_ENDPOINT=
# onnxruntime telemetry upload (it connects to mobile.events.data.microsoft.com otherwise): milk10k_serving sets 1
# by default before onnxruntime is imported; set 0 here to allow it
ORT_DISABLE_TELEMETRY=1

# Docker Compose (compose.yaml; read by `docker compose`, not by the API)
# Host port of the API, published on 127.0.0.1 only
API_PORT=8000
# Host folder with the model package, mounted read-only at /models/final-P1a-kg-onnx (scripts/fetch_model.sh fills it)
MODEL_HOST_DIR=./artifacts/model_package/final-P1a-kg-onnx
# Memory limit of the API container (measured RSS 2.0-2.5 GiB, docs/serving_measurements.md)
API_MEMORY_LIMIT=3g
# Docker Compose network: OTLP endpoint the API container sends traces to (empty = tracing off in the container)
API_OTLP_ENDPOINT=http://jaeger:4318

# Monitoring UIs (published on 127.0.0.1 only)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_UI_PORT=16686
# Grafana login. The password is REQUIRED (no default; Compose refuses to start without it): `make env` creates .env
# with a random one. It is applied when Grafana's database is first created (volume grafana-data); to change it later,
# change it in Grafana or remove the volume (`docker compose down -v`).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Memory limits of the monitoring services (sized from docs/serving_measurements.md §10)
PROMETHEUS_MEMORY_LIMIT=512m
GRAFANA_MEMORY_LIMIT=512m
NODE_EXPORTER_MEMORY_LIMIT=128m
CADVISOR_MEMORY_LIMIT=256m
JAEGER_MEMORY_LIMIT=512m
