# Copy to .env and adjust. .env is gitignored; never commit real credentials.
# Serving settings (read by milk10k_serving.settings; empty = default shown).

# Model package folder (written by notebooks/08_export_for_deployment.ipynb or downloaded from the GitHub Release)
MODEL_DIR=artifacts/model_package/final-P1a-kg-onnx
# Check every package file against manifest.json at startup (true/false)
MODEL_VERIFY_SHA256=true
# ONNX Runtime threads per session
ORT_INTRA_OP_THREADS=4
# Largest accepted image upload, in MB
MAX_UPLOAD_MB=10
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
# Tracing (OTLP to Jaeger); leave the endpoint empty to disable tracing
OTEL_SERVICE_NAME=milk10k-api
OTEL_EXPORTER_OTLP_ENDPOINT=
