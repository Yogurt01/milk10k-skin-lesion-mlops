      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(up{job=\"api\", namespace=\"$namespace\"})",
          "legendFormat": "up"
        }
      ],
      "description": "API Pods Prometheus scrapes successfully (one target per Pod, from the ServiceMonitor)."
    },
    {
      "type": "stat",
      "title": "Model ready per Pod",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "milk10k_model_ready{namespace=\"$namespace\"}",
          "legendFormat": "{{pod}}",
          "instant": true,
          "range": false
        }
      ],
      "description": "1 once a Pod's model is loaded. Instant query: only Pods that are scraped now, not Pods deleted earlier in the time range."
    },
    {
      "type": "row",
      "title": "API Pods: CPU and memory (kubelet)",
