# Copy to ci/.env (gitignored) for `make ci-up`. Read by `docker compose -f ci/compose.yaml`, not by the pipeline.
# Prepared MILK10k dataset on this machine (test_metadata.csv, test/derm/, test/clinical/), mounted read-only at the
# same path; used only to build the sample lesions (P1-DEC-10). Never commit dataset files.
CI_DATASET_DIR=
# Jenkins UI on 127.0.0.1
JENKINS_PORT=8081
# Memory limit of the Jenkins container (no extra swap) and its Java heap (CI-D8)
JENKINS_MEMORY_LIMIT=1536m
JENKINS_HEAP=768m
